{
  "name": "superbaser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:pages": "npm run build && echo 'Push to main branch — Cloudflare Pages auto-deploys via GitHub CI/CD'",
    "deploy:agent": "cd worker && npm install --legacy-peer-deps && npx wrangler deploy",
    "deploy:ingestion": "cd ingestion && npx wrangler deploy",
    "deploy:sentinel": "cd sentinel && npx wrangler deploy",
    "agent:dev": "cd worker && npx wrangler dev",
    "agent:tail": "npx wrangler tail --name superbaser-agent",
    "setup:agent": "powershell -ExecutionPolicy Bypass -File scripts/setup-agent.ps1"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/typography": "^0.5.20",
    "framer-motion": "^12.42.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@cloudflare/ai-chat": "^0.10.0",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "agents": "^0.19.0",
    "ai": "^7.0.37",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wrangler": "^4.114.0"
  }
}
